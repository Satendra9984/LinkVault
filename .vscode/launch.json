{
  "version": "0.2.0",
  "configurations": [
    // ──────────────────────────────────────────────────────────────────────────────
    // 1) Development Flavor  (debug with hot-reload)
    // ──────────────────────────────────────────────────────────────────────────────
    {
      "name": "web_link_store (dev – debug)",
      "request": "launch",
      "type": "dart",

      // “debug” mode gives you hot-reload, full stack traces, breakpoints, etc.
      "flutterMode": "debug",

      // If you use a separate entrypoint file:
      //   -t lib/main_dev.dart
      // If you keep a single main.dart that reads const flavor = String.fromEnvironment("FLAVOR"),
      //   you can still just pass “-t lib/main.dart”.
      "program": "lib/mains.dart",

      // All CLI flags to flutter run go in “args”.
      // ––flavor picks the Gradle product flavor
      // ––dart-define passes the same value into Dart via const String.fromEnvironment("FLAVOR")
      "args": [
        "--flavor", "development",
        "--dart-define", "FLAVOR=development"
      ],

      // (Optional) You can set environment vars here, or pass `cwd`, but usually not needed.
      // "cwd": "${workspaceFolder}"
    },

    // ──────────────────────────────────────────────────────────────────────────────
    // 2) Production Flavor  (debug with hot-reload)
    // ──────────────────────────────────────────────────────────────────────────────
    {
      "name": "web_link_store (prod – debug)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "program": "lib/mains.dart",
      "args": [
        "--flavor", "production",
        "--dart-define", "FLAVOR=production"
      ]
    }

    //  If you truly need profile/release here, you can duplicate one of the above
    //  blocks and change “flutterMode” => “profile” or “release” and/or remove hot-reload-related flags.
    //
    //  e.g.:
    //  {
    //    "name": "web_link_store (prod – release)",
    //    "request": "launch",
    //    "type": "dart",
    //    "flutterMode": "release",
    //    "program": "lib/mains.dart",
    //    "args": [
    //      "--flavor", "production",
    //      "--dart-define", "FLAVOR=production"
    //    ]
    //  }
  ]
}



